GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REFLECT_MODEL=llama-3.1-8b-instant
DATABASE_URL=postgresql://mcp:mcp@postgres:5432/mcp
CNN_WORKER_URL=http://cnn-worker:8000
UPLOAD_DIR=/data/uploads
DEFAULT_TZ=Asia/Kolkata
PORT=4000
# Optional: OpenAI-compatible embeddings endpoint (must return 1536 dims). Empty = local hashed embedder.
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
NEXT_PUBLIC_API_URL=http://localhost:4000
